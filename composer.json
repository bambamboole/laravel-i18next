{
    "name": "bambamboole/laravel-i18next",
    "description": "A laravel package which provides a HTTP backend for i18next.js",
    "keywords": [
        "bambamboole",
        "laravel",
        "i18next",
        "translations"
    ],
    "homepage": "https://github.com/bambamboole/laravel-i18next",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Manuel Christlieb",
            "email": "manuel@christlieb.eu"
        }
    ],
    "require": {
        "php": "^8.3",
        "bambamboole/laravel-translation-dumper": "^2.0",
        "illuminate/cache": "^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/translation": "^11.0 || ^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.16 || ^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.16",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Bambamboole\\LaravelI18Next\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bambamboole\\LaravelI18Next\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "lint": "vendor/bin/pint",
        "test:lint": "vendor/bin/pint --test",
        "test": "vendor/bin/pest --testsuite Unit,Feature",
        "test:browser": "vendor/bin/pest --testsuite Browser",
        "test:coverage": "vendor/bin/pest --testsuite Unit,Feature --coverage",
        "serve": "@php vendor/bin/testbench serve"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bambamboole\\LaravelI18Next\\I18NextServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
